PORT=3000
NODE_ENV=development

# Change these before publishing the site.
ADMIN_USERNAME=owner
ADMIN_PASSWORD=ChangeThisPassword123!

# Replace with the real public phone number, digits and optional + only.
PUBLIC_PHONE=+380XXXXXXXXX
INSTAGRAM_URL=https://instagram.com/your_account

# Used for cookie signing. Replace with a long random value before deployment.
SESSION_SECRET=replace-this-with-a-long-random-secret-at-least-32-characters
